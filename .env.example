# Configuración de la base de datos
POSTGRES_DB=balanceDb
POSTGRES_USER=balance
POSTGRES_PASSWORD=balancePassword
# Host de la BD: "localhost" en local; "db" lo fija docker-compose para el backend
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Directorio donde se guardan los XML de información exógena (relativo a Backend/ o absoluto)
EXOGENA_FILES_DIR=exogena_files

# Integración externa del valor de la UVT
UVT_API_URL=https://uvt.com.co/
UVT_SIMULADOR_URL=http://127.0.0.1:8000
UVT_INTERVALO_SEGUNDOS=21600

# Orígenes permitidos para CORS/CSRF (separados por coma)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Autenticación (firmado de tokens)
SECRET_KEY=cambia-esta-clave-secreta-en-desarrollo
TOKEN_SEGUNDOS=86400

# Frontend: URL del backend alcanzable desde el navegador del host (se usa en build de Docker)
NEXT_PUBLIC_API_URL=http://localhost:8000
